# ==============================================================================
# AlphabetAI Education Attendance System - Environment Variables
# ==============================================================================

# Database Settings
# For Docker: postgresql://postgres:alphabet_secret_password@db:5432/alphabet_attendance
# For Local SQLite: sqlite:///./alphabet_attendance.db
DATABASE_URL=sqlite:///./alphabet_attendance.db

# PostgreSQL Credentials (when running Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=alphabet_secret_password
POSTGRES_DB=alphabet_attendance

# Authentication & Security
SECRET_KEY=alphabetai-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
TEACHER_DEFAULT_PIN=1234

# AI Vision & Biometrics Settings
FACE_CONFIDENCE_THRESHOLD=0.65
UNKNOWN_FACE_THRESHOLD=0.50
DUPLICATE_ATTENDANCE_COOLDOWN_SECONDS=300
STORE_RAW_FACE_IMAGES=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000
